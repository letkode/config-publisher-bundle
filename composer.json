{
    "name": "letkode/config-publisher",
    "description": "Publishes the example config files that letkode/* packages ship, with a single command",
    "type": "library",
    "license": "MIT",
    "bin": ["bin/letkode-publish"],
    "require": {
        "php": "^8.4",
        "symfony/console": "^7.0 || ^8.0",
        "symfony/filesystem": "^7.0 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11",
        "phpstan/phpstan": "^2",
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "autoload": {
        "psr-4": {
            "Letkode\\ConfigPublisher\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Letkode\\ConfigPublisher\\Tests\\": "tests/"
        }
    }
}
