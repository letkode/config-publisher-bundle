{
    "name": "letkode/config-publisher-bundle",
    "description": "Publishes the example config files that letkode/* packages ship, with a single command (bin/console letkode:config:publish)",
    "type": "symfony-bundle",
    "license": "MIT",
    "bin": ["bin/letkode-publish"],
    "require": {
        "php": "^8.4",
        "symfony/config": "^7.0 || ^8.0",
        "symfony/console": "^7.0 || ^8.0",
        "symfony/dependency-injection": "^7.0 || ^8.0",
        "symfony/filesystem": "^7.0 || ^8.0",
        "symfony/http-kernel": "^7.0 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11",
        "phpstan/phpstan": "^2",
        "friendsofphp/php-cs-fixer": "^3.95",
        "symfony/framework-bundle": "^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Letkode\\ConfigPublisherBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Letkode\\ConfigPublisherBundle\\Tests\\": "tests/"
        }
    }
}
